{
  "name": "negosyo-os",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db --local",
    "db:types": "supabase gen types typescript --local > src/types/database.ts",
    "db:types:linked": "supabase gen types typescript --linked > src/types/database.ts"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.112.2",
    "expo": "~57.0.11",
    "expo-constants": "~57.0.9",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "~19.2.2",
    "eslint": "^9",
    "eslint-config-expo": "57.0.1",
    "supabase": "^2.111.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
