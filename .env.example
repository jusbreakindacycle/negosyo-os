# NegosyoOS PH — environment template
#
# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored. Never commit real credentials.
#
#   cp .env.example .env.local
#
# Values below are placeholders only.

# ---------------------------------------------------------------------------
# Supabase — browser-safe values
# ---------------------------------------------------------------------------
# Both variables below are prefixed NEXT_PUBLIC_, which means Next.js inlines
# them into the client bundle. Only ever put browser-safe values here.
#
# The publishable key is the current Supabase naming for what older guides
# called the "anon" key. It is safe to expose because every table it can reach
# is protected by Row Level Security.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# ---------------------------------------------------------------------------
# Secrets — server only
# ---------------------------------------------------------------------------
# The service-role key bypasses Row Level Security completely. It must never be
# given a NEXT_PUBLIC_ prefix, never be imported into a Client Component, and
# never be committed. No server-side secret is required by the current
# milestone, so none is listed here yet.
